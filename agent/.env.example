# Copie para um arquivo .env fora do repositório e preencha localmente.
DM4615_MGMT_HOST=192.168.0.25
DM4615_MGMT_PORT=22
DM4615_AGENT_TOKEN=gere-um-token-aleatorio-com-pelo-menos-32-caracteres
# Obtenha e confira esta impressão digital diretamente da OLT por canal confiável.
DM4615_SSH_HOST_KEY_SHA256=SHA256:SUBSTITUA_PELA_IMPRESSAO_DIGITAL_VERIFICADA
# URL exata da aplicação web autorizada. Separe várias origens por vírgula.
DM4615_ALLOWED_ORIGINS=http://localhost:5173
